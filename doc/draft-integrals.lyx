\begin_layout Standard

\lang russian
\begin_inset Formula 
\begin{align*}
\dot{\rho} & =r\cos\alpha\zeta_{\phi}\\
\dot{\phi} & =-\frac{r}{\rho}\zeta_{\rho}\\
\dot{\zeta}_{\rho} & =\dot{\theta}\left(k+1\right)\cos\alpha\zeta_{\phi}-\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}+\left(k-1\right)\sin\alpha\ddot{\theta}+\frac{k\rho}{r}\ddot{\theta}\\
\dot{\zeta}_{\phi} & =-\frac{gk}{r}\sin\alpha+\rho\frac{k}{r}\cos\alpha\dot{\theta}^{2}-\cos\alpha\left(k\dot{\theta}\zeta_{\rho}+\dot{\theta}\zeta_{\rho}-\frac{r}{\rho}\zeta_{\rho}^{2}\right)+\left(1-k\right)\sin\alpha\left(\dot{\theta}\zeta_{n}-\frac{r}{\rho}\zeta_{\rho}\zeta_{n}\right)\\
\dot{\zeta}_{n} & =-\sin\alpha\left(\dot{\theta}\zeta_{\phi}-\frac{r}{\rho}\zeta_{\rho}\zeta_{\phi}\right)-\cos\alpha\ddot{\theta}
\end{align*}

\end_inset


\end_layout

