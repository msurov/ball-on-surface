\begin_layout Standard
\begin_inset Formula 
\begin{align}
\dot{\rho} & =r\cos\alpha\zeta_{\phi}\label{eq:ball-on-cone-dynamics}\\
\dot{\phi} & =-\frac{r}{\rho}\zeta_{\rho}\nonumber \\
\dot{\zeta}_{\rho} & =\left[\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\phi}-\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}\right]\nonumber \\
\dot{\zeta}_{\phi} & =\left[-\frac{gk}{r}\sin\alpha+\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}+\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}-\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}-\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}+\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}\right]\nonumber \\
\dot{\zeta}_{n} & =\left[-\sin\alpha\dot{\theta}\zeta_{\phi}+\frac{r}{\rho}\sin\alpha\zeta_{\rho}\zeta_{\phi}\right]\nonumber 
\end{align}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
I & =a\left(\rho\right)\zeta_{\rho}^{2}+b\left(\rho\right)\zeta_{\phi}^{2}+c\left(\rho\right)\zeta_{n}^{2}\\
 & +d\left(\rho\right)\zeta_{\rho}\zeta_{\phi}+e\left(\rho\right)\zeta_{\phi}\zeta_{n}+f\left(\rho\right)\zeta_{\rho}\zeta_{n}+w\left(\rho\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\dot{I} & =a'r\cos\alpha\zeta_{\phi}\zeta_{\rho}^{2}+b'r\cos\alpha\zeta_{\phi}\zeta_{\phi}^{2}+c'r\cos\alpha\zeta_{\phi}\zeta_{n}^{2}\\
 & +2a\zeta_{\rho}\dot{\zeta}_{\rho}+2b\zeta_{\phi}\dot{\zeta}_{\phi}+2c\zeta_{n}\dot{\zeta}_{n}\\
 & +d'r\cos\alpha\zeta_{\phi}\zeta_{\rho}\zeta_{\phi}+e'r\cos\alpha\zeta_{\phi}\zeta_{\phi}\zeta_{n}+f'r\cos\alpha\zeta_{\phi}\zeta_{\rho}\zeta_{n}+w'r\cos\alpha\zeta_{\phi}\\
 & +d\dot{\zeta}_{\rho}\zeta_{\phi}+e\dot{\zeta}_{\phi}\zeta_{n}+f\dot{\zeta}_{\rho}\zeta_{n}\\
 & +d\zeta_{\rho}\dot{\zeta}_{\phi}+e\zeta_{\phi}\dot{\zeta}_{n}+f\zeta_{\rho}\dot{\zeta}_{n}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\dot{I} & =a'r\cos\alpha\zeta_{\phi}\zeta_{\rho}^{2}+b'r\cos\alpha\zeta_{\phi}\zeta_{\phi}^{2}+c'r\cos\alpha\zeta_{\phi}\zeta_{n}^{2}\\
 & +2a\zeta_{\rho}\left[\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\phi}-\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}\right]\\
 & +2b\zeta_{\phi}\left[-\frac{gk}{r}\sin\alpha+\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}+\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}-\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}-\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}+\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}\right]\\
 & +2c\zeta_{n}\left[-\sin\alpha\dot{\theta}\zeta_{\phi}+\frac{r}{\rho}\sin\alpha\zeta_{\rho}\zeta_{\phi}\right]\\
 & +d'r\cos\alpha\zeta_{\phi}\zeta_{\rho}\zeta_{\phi}+e'r\cos\alpha\zeta_{\phi}\zeta_{\phi}\zeta_{n}+f'r\cos\alpha\zeta_{\phi}\zeta_{\rho}\zeta_{n}+w'r\cos\alpha\zeta_{\phi}\\
 & +d\left[\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\phi}-\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}\right]\zeta_{\phi}\\
 & +e\left[-\frac{gk}{r}\sin\alpha+\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}+\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}-\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}-\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}+\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}\right]\zeta_{n}\\
 & +f\left[\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\phi}-\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}\right]\zeta_{n}\\
 & +d\zeta_{\rho}\left[-\frac{gk}{r}\sin\alpha+\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}+\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}-\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}-\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}+\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}\right]\\
 & +e\zeta_{\phi}\left[-\sin\alpha\dot{\theta}\zeta_{\phi}+\frac{r}{\rho}\sin\alpha\zeta_{\rho}\zeta_{\phi}\right]\\
 & +f\zeta_{\rho}\left[-\sin\alpha\dot{\theta}\zeta_{\phi}+\frac{r}{\rho}\sin\alpha\zeta_{\rho}\zeta_{\phi}\right]
\end{align*}

\end_inset


\end_layout

