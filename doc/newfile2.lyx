\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\dot{I} & =b'r\cos\alpha\zeta_{\phi}^{3}+a'r\cos\alpha\zeta_{\phi}\zeta_{\rho}^{2}+c'r\cos\alpha\zeta_{\phi}\zeta_{n}^{2}\\
 & +2a\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}\zeta_{\phi}-2a\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}\zeta_{\phi}\\
 & -2b\frac{gk}{r}\sin\alpha\zeta_{\phi}+2b\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}\zeta_{\phi}+2b\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}\zeta_{\phi}-2b\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}\zeta_{\phi}-2b\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}\zeta_{\phi}+2b\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}\zeta_{\phi}\\
 & -2c\sin\alpha\dot{\theta}\zeta_{n}\zeta_{\phi}+2c\frac{r}{\rho}\sin\alpha\zeta_{n}\zeta_{\rho}\zeta_{\phi}\\
 & +d'r\cos\alpha\zeta_{\phi}^{2}\zeta_{\rho}+e'r\cos\alpha\zeta_{\phi}^{2}\zeta_{n}+f'r\cos\alpha\zeta_{\phi}\zeta_{\rho}\zeta_{n}+w'r\cos\alpha\zeta_{\phi}\\
 & +d\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\phi}^{2}-d\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}^{2}\\
 & -e\frac{gk}{r}\sin\alpha\zeta_{n}+e\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}\zeta_{n}+e\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}\zeta_{n}-e\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{n}\zeta_{\rho}-e\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}\zeta_{n}+e\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}\zeta_{n}\\
 & +f\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\phi}\zeta_{n}-f\frac{r}{\rho}\cos\alpha\zeta_{\rho}\zeta_{\phi}\zeta_{n}\\
 & -\frac{gk}{r}\sin\alpha d\zeta_{\rho}+\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}d\zeta_{\rho}+\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}d\zeta_{\rho}-\left(k+1\right)\cos\alpha\dot{\theta}\zeta_{\rho}d\zeta_{\rho}-\left(k-1\right)\sin\alpha\dot{\theta}\zeta_{n}d\zeta_{\rho}+\frac{r\left(k-1\right)}{\rho}\sin\alpha\zeta_{\rho}\zeta_{n}d\zeta_{\rho}\\
 & -e\sin\alpha\dot{\theta}\zeta_{\phi}\zeta_{\phi}+e\frac{r}{\rho}\sin\alpha\zeta_{\rho}\zeta_{\phi}\zeta_{\phi}\\
 & -f\sin\alpha\dot{\theta}\zeta_{\phi}\zeta_{\rho}+f\frac{r}{\rho}\sin\alpha\zeta_{\rho}\zeta_{\phi}\zeta_{\rho}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\dot{I} & =\left[b'r\cos\alpha\right]\zeta_{\phi}^{3}\\
 & \left[+d\frac{r}{\rho}\cos\alpha\right]\zeta_{\rho}^{3}\\
 & \left[+a'r\cos\alpha\zeta_{\phi}\zeta_{\rho}^{2}-2a\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}\zeta_{\phi}+2b\frac{r}{\rho}\cos\alpha\zeta_{\rho}^{2}\zeta_{\phi}+f\frac{r}{\rho}\sin\alpha\zeta_{\rho}^{2}\zeta_{\phi}\right]\\
 & \left[+c'r\cos\alpha\right]\zeta_{\phi}\zeta_{n}^{2}\\
 & \left[+d'r\cos\alpha-d\frac{r}{\rho}\cos\alpha+e\frac{r}{\rho}\sin\alpha\right]\zeta_{\phi}^{2}\zeta_{\rho}\\
 & \left[+e'r\cos\alpha\right]\zeta_{\phi}^{2}\zeta_{n}\\
 & \left[+e\frac{r}{\rho}\cos\alpha+d\frac{r\left(k-1\right)}{\rho}\sin\alpha\right]\zeta_{\rho}^{2}\zeta_{n}\\
 & \left[+e\frac{r\left(k-1\right)}{\rho}\sin\alpha\right]\zeta_{\rho}\zeta_{n}^{2}\\
 & \left[-f\frac{r}{\rho}\cos\alpha+2b\frac{r\left(k-1\right)}{\rho}\sin\alpha+2c\frac{r}{\rho}\sin\alpha+f'r\cos\alpha\right]\zeta_{\rho}\zeta_{\phi}\zeta_{n}\\
\hline \\ & \left[+2a\left(k+1\right)\cos\alpha\dot{\theta}-2b\left(k+1\right)\cos\alpha\dot{\theta}-f\sin\alpha\dot{\theta}\right]\zeta_{\rho}\zeta_{\phi}\\
 & \left[-2b\left(k-1\right)\sin\alpha\dot{\theta}-2c\sin\alpha\dot{\theta}+f\left(k+1\right)\cos\alpha\dot{\theta}\right]\zeta_{n}\zeta_{\phi}\\
 & \left[-e\left(k+1\right)\cos\alpha\dot{\theta}-d\left(k-1\right)\sin\alpha\dot{\theta}\right]\zeta_{n}\zeta_{\rho}\\
\hline \\ & \left[+d\left(k+1\right)\cos\alpha\dot{\theta}-e\sin\alpha\dot{\theta}\right]\zeta_{\phi}^{2}\\
 & \left[-e\left(k-1\right)\sin\alpha\dot{\theta}\right]\zeta_{n}^{2}\\
 & \left[-d\left(k+1\right)\cos\alpha\dot{\theta}\right]\zeta_{\rho}^{2}\\
\\\hline \\ & \left[-2b\frac{gk}{r}\sin\alpha+2b\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}+w'r\cos\alpha\right]\zeta_{\phi}\\
 & \left[-d\frac{gk}{r}\sin\alpha+d\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}\right]\zeta_{\rho}\\
 & \left[-e\frac{gk}{r}\sin\alpha+e\frac{\rho k}{r}\cos\alpha\dot{\theta}^{2}\right]\zeta_{n}\\
\\\\\\\\\\
\end{align*}

\end_inset


